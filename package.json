{
  "name": "@codepql/qicode",
  "version": "0.1.0",
  "description": "A terminal-first AI coding assistant.",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Codepql/QiCode.git"
  },
  "bugs": {
    "url": "https://github.com/Codepql/QiCode/issues"
  },
  "homepage": "https://github.com/Codepql/QiCode#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "qicode": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.tsx",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "chalk": "^6.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.1",
    "js-yaml": "^5.2.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
